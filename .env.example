CI_ENVIRONMENT = production

# Domain aplikasi. Nginx diarahkan ke folder public.
app.baseURL = 'https://sipv5ai.test/'
app.forceGlobalSecureRequests = true
cookie.secure = true

# Database aplikasi, terpisah dari POS.
database.default.hostname = 127.0.0.1
database.default.database = dbsiprosir_aichatbot
database.default.username = ai_app
database.default.password = 'REPLACE_WITH_RANDOM_APPLICATION_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.DBDebug = false

# Ganti dengan nilai acak panjang pada instalasi produksi.
# encryption.key =

# Akun POS hanya SELECT tabel bisnis; jangan gunakan akun database aplikasi.
database.posReadonly.hostname = 127.0.0.1
database.posReadonly.database = YOUR_POS_DATABASE
database.posReadonly.username = ai_pos_select
database.posReadonly.password = 'REPLACE_WITH_POS_READONLY_PASSWORD'
database.posReadonly.DBDriver = MySQLi
database.posReadonly.port = 3307
database.posReadonly.DBDebug = false

ai.storageDriver = database
ai.timezone = Asia/Jakarta
ai.posDatabaseGroup = posReadonly
# Fixture hanya tersedia pada testing; simulasi operasional dinonaktifkan.
# Server file provider_config.json overrides these initial defaults.
ai.provider = openai-compatible
ai.baseUrl = 'https://YOUR_PROVIDER/v1'
ai.apiKey = ''
ai.model = 'YOUR_MODEL'
ai.timeoutSeconds = 30
ai.reasoningEffort = auto
ai.defaultRowLimit = 100
ai.maxRowLimit = 500
ai.queryTimeoutSeconds = 8
